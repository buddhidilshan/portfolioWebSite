---
interface Entry {
  dates: string;
  title: string;
  org: string;
  note?: string;
}

interface Props {
  entries: Entry[];
}

const { entries } = Astro.props;
---

<ul class="timeline">
  {
    entries.map((entry) => (
      <li class="timeline-item">
        <div class="timeline-meta">
          <span class="timeline-dates">{entry.dates}</span>
        </div>
        <div class="timeline-body">
          <h4>{entry.title}</h4>
          <p class="timeline-org">{entry.org}</p>
          {entry.note && <p>{entry.note}</p>}
        </div>
      </li>
    ))
  }
</ul>
