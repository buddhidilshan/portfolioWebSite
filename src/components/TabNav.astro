---
// The tab strip. Markup only — the sliding pill, hash routing and keyboard
// navigation all live in src/scripts/tabs.js.
interface Tab {
  id: string;
  label: string;
}

interface Props {
  tabs: Tab[];
}

const { tabs } = Astro.props;
---

<nav class="tabnav" aria-label="Section navigation">
  <div class="tabnav-track" role="tablist" aria-orientation="horizontal">
    <span class="tab-pill" aria-hidden="true"></span>
    {
      tabs.map((tab, i) => (
        <button
          class="tab"
          id={`tab-${tab.id}`}
          role="tab"
          data-target={tab.id}
          aria-selected={i === 0 ? "true" : "false"}
          aria-controls={`panel-${tab.id}`}
          tabindex={i === 0 ? 0 : -1}
        >
          {tab.label}
        </button>
      ))
    }
  </div>
</nav>
