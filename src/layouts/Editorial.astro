---
import hero from "../data/hero.json";
import Footer from "../components/Footer.astro";
import "../styles/hero.css";
import "../styles/polish.css";
import "../styles/blog.css";
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — Buddhi Dilshan</title><meta name="description" content={description} />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta name="theme-color" content="#f5f7f1" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body id="top" class="editorial-page">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="editorial-header">
    <a class="hero-wordmark" href="/">{hero.brand}<span class="asterisk" aria-hidden="true">✳</span></a>
    <nav aria-label="Primary"><a href="/">Home</a><a href="/#projects">Projects</a><a href="/blog/" aria-current={Astro.url.pathname.startsWith("/blog") ? "page" : undefined}>Blog</a><a href="/portfolio/">About</a></nav>
  </header>
  <main id="main" tabindex="-1"><slot /></main>
  <Footer />
</body>
</html>

