---
import Analytics from "@vercel/analytics/astro";
import Seo from "../components/Seo.astro";
import site from "../data/site.json";
import SiteIcons from "../components/SiteIcons.astro";
import hero from "../data/hero.json";
import Footer from "../components/Footer.astro";
import "../styles/hero.css";
import "../styles/polish.css";
import "../styles/blog.css";
import "../styles/silver.css";
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <Seo title={`${title} | ${site.name} — ${site.author}`} description={description} />
  <meta name="theme-color" content="#f5f5f7" />
  <SiteIcons />
</head>
<body id="top" class="editorial-page">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="editorial-header">
    <a class="hero-wordmark" href="/"><img class="brand-logo" src="/assets/beroxv-brand.png" width="164" height="40" alt="Beroxv" /></a>
    <nav aria-label="Primary"><a class="home-return" href="/">← Home</a><a href="/#projects">Projects</a><a href="/blog/" aria-current={Astro.url.pathname.startsWith("/blog") ? "page" : undefined}>Blog</a><a href="/portfolio/">About</a></nav>
  </header>
  <main id="main" tabindex="-1"><slot /></main>
  <Footer />
  <Analytics />
</body>
</html>

