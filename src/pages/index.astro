---
import Analytics from "@vercel/analytics/astro";
import Seo from "../components/Seo.astro";
import SiteIcons from "../components/SiteIcons.astro";
import Icon from "../components/Icon.astro";
import hero from "../data/hero.json";
import site from "../data/site.json";
import qualifications from "../data/qualifications.json";
import experience from "../data/experience.json";
import skills from "../data/skills.json";
import projects from "../data/projects.json";
import "../styles/hero.css";
import "../styles/work.css";
import "../styles/polish.css";
import "../styles/silver.css";
import "../styles/immersive.css";
import BlogListing from "../components/BlogListing.astro";
import Footer from "../components/Footer.astro";
import WorkspaceSketch from "../components/WorkspaceSketch.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo />
    <SiteIcons />
    <meta name="theme-color" content="#f5f5f7" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body id="top" class="landing-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <noscript><nav class="no-js-nav" aria-label="Navigation"><a href="#projects">Projects</a> · <a href="/blog/">Blog</a> · <a href="/portfolio/">About me</a></nav></noscript>
    <div class="hero-root" data-motion="on">
      <div class="content-group">
        <header>
          <nav class="hero-nav" aria-label="Primary">
            <a class="hero-wordmark" href="/">
              <img class="brand-logo" src="/assets/beroxv-brand.png" width="164" height="40" alt="Beroxv Tomorrow" />
            </a>

            <div class="hero-nav-links">
              {
                hero.navLinks.map((link, i) => (
                  <>
                    {i > 0 && <span class="sep" aria-hidden="true">,</span>}
                    {link.panel
                      ? <button type="button" data-panel={link.panel}>{link.label}</button>
                      : <a href={link.href}>{link.label}</a>}
                  </>
                ))
              }
            </div>

            <button
              type="button"
              class="nav-toggle"
              aria-label="Open menu"
              aria-expanded="false"
              aria-controls="mobile-navigation"
            >
              <span></span><span></span><span></span>
            </button>
          </nav>
        </header>

        <button type="button" class="menu-backdrop" aria-hidden="true" tabindex="-1" hidden></button>
        <div class="mobile-nav" id="mobile-navigation" data-open="false" aria-hidden="true" inert>
          <nav aria-label="Mobile navigation">
            {
              hero.navLinks.map((link, i) => (
                link.panel
                  ? <button type="button" class="mobile-link" data-panel={link.panel}>
                      {link.label}<span class="mobile-index">0{i + 1}</span>
                    </button>
                  : <a href={link.href}>
                      {link.label}<span class="mobile-index">0{i + 1}</span>
                    </a>
              ))
            }
          </nav>
        </div>

        <main class="hero-main" id="main" tabindex="-1">
          <WorkspaceSketch />
          <div class="hero-light-field" aria-hidden="true">
            <div class="light-bloom"></div>
            <svg class="light-trails" viewBox="0 0 480 760" fill="none" preserveAspectRatio="none">
              <defs>
                <linearGradient id="plum-light" x1="460" y1="60" x2="190" y2="720" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#6b0070" stop-opacity="0" />
                  <stop offset=".35" stop-color="#b76fca" stop-opacity=".65" />
                  <stop offset=".58" stop-color="#fff1ff" />
                  <stop offset=".8" stop-color="#a244b4" stop-opacity=".65" />
                  <stop offset="1" stop-color="#6b0070" stop-opacity="0" />
                </linearGradient>
              </defs>
              <g stroke="url(#plum-light)">
                <path class="trail-haze" d="M490 -60 L342 274 Q325 310 340 354 L416 580 Q435 634 386 780" />
                <path class="trail-core" d="M490 -60 L342 274 Q325 310 340 354 L416 580 Q435 634 386 780" />
                <path class="trail-fine" d="M423 -45 L294 267 Q278 308 294 352 L368 579 Q388 635 338 780" />
                <path class="trail-fine trail-outer" d="M545 -25 L390 287 Q376 316 391 360 L465 580" />
                <path class="trail-pulse" pathLength="100" d="M490 -60 L342 274 Q325 310 340 354 L416 580 Q435 634 386 780" />
              </g>
              <g class="light-nodes" fill="#fff1ff">
                <circle cx="342" cy="274" r="3" />
                <circle cx="407" cy="552" r="2" />
                <circle cx="320" cy="198" r="1.5" />
              </g>
            </svg>
          </div>
          <div class="hero-copy">


            <h1>Less manual.<br /><em>More possible.</em></h1>

            <p class="hero-description">{hero.description}</p>
            <div class="hero-actions-row"><a class="hero-primary" href="#projects">Explore my work <span>↗</span></a><button class="hero-secondary" type="button" data-panel="contact">Let’s talk <span>↗</span></button></div>


          </div>
      <aside class="art-stage" aria-label="Portrait of the creator behind Beroxv">
        <div
          class="portrait-plane"
          role="img"
          aria-label="Portrait of the creator behind Beroxv"
        >
          <img class="portrait-image" src="/assets/portrait-blend.webp" srcset="/assets/portrait-blend-mobile.webp 1000w, /assets/portrait-blend.webp 1536w" sizes="(max-width: 767px) 740px, 1100px" alt="" width="1536" height="1024" fetchpriority="high" decoding="async" draggable="false" />

        </div>

      </aside>
        </main>
            <section class="service-studio" aria-labelledby="service-title">
              <h2 id="service-title">{hero.serviceTitle}</h2>
              <p class="service-help" id="service-help">{hero.serviceHelp}</p>

              <div
                class="service-pills"
                role="group"
                aria-labelledby="service-title"
                aria-describedby="service-help"
              >
                {
                  hero.serviceOptions.map((service) => (
                    <button
                      type="button"
                      class="service-pill"
                      data-pill={service}
                      aria-pressed="false"
                    >
                      <span class="pill-check"><Icon name="check" size={17} /></span>
                      {service}
                    </button>
                  ))
                }
              </div>

              <div class="service-feedback" role="status" aria-live="polite" aria-atomic="true">
                <p class="empty-feedback">Choose an area to shape our conversation.</p>

                <div class="feedback-banner-wrap" hidden>
                  <div class="feedback-banner">
                    <span class="feedback-check"><Icon name="check" size={18} /></span>
                    <p>Ready to talk about: <strong class="feedback-services"></strong></p>
                    <button type="button" class="feedback-cta" data-panel="contact">
                      Let's Go <Icon name="arrowRight" size={17} />
                    </button>
                  </div>
                </div>
              </div>
            </section>
      </div>



      <!-- ============ Nav dialogs ============ -->

      <dialog class="hero-dialog" data-panel="qualifications" aria-labelledby="dlg-qual">
        <div class="dialog-body">
          <div class="dialog-head">
            <span class="dialog-kicker">{hero.dialogs.qualifications.kicker}</span>
            <button type="button" class="dialog-close" aria-label="Close">
              <Icon name="close" size={21} />
            </button>
          </div>
          <h2 id="dlg-qual">{hero.dialogs.qualifications.title}</h2>
          <p class="dialog-lede">Education and certification details will be added soon. Explore my projects to see the work in practice.</p>

          {qualifications.education.some(entry => !entry.draft) && <p class="dialog-group">Education</p>}
          {
            qualifications.education.filter(entry => !entry.draft).map((entry) => (
              <div class="dialog-entry">
                <span class="dialog-entry-dates">{entry.dates}</span>
                <h3>{entry.title}</h3>
                <p class="dialog-entry-org">{entry.org}</p>
                {entry.note && <p>{entry.note}</p>}
              </div>
            ))
          }

          {qualifications.certifications.some(entry => !entry.draft) && <p class="dialog-group">Certifications</p>}
          {
            qualifications.certifications.filter(cert => !cert.draft).map((cert) => (
              <div class="dialog-entry">
                <h3>{cert.name}</h3>
                <p class="dialog-entry-org">{cert.issuer} · {cert.year}</p>
              </div>
            ))
          }
        </div>
      </dialog>

      <dialog class="hero-dialog" data-panel="experience" aria-labelledby="dlg-exp">
        <div class="dialog-body">
          <div class="dialog-head">
            <span class="dialog-kicker">{hero.dialogs.experience.kicker}</span>
            <button type="button" class="dialog-close" aria-label="Close">
              <Icon name="close" size={21} />
            </button>
          </div>
          <h2 id="dlg-exp">{hero.dialogs.experience.title}</h2>
          <p class="dialog-lede">{experience.lede}</p>
          {
            experience.roles.filter(role => !role.draft).map((role) => (
              <div class="dialog-entry">
                {!role.dates.includes("20XX") && <span class="dialog-entry-dates">{role.dates}</span>}
                <h3>{role.title}</h3>
                <p class="dialog-entry-org">{role.org}</p>
                <ul class="dialog-bullets">
                  {role.bullets.map((bullet) => <li>{bullet}</li>)}
                </ul>
              </div>
            ))
          }
        </div>
      </dialog>

      <dialog class="hero-dialog" data-panel="skills" aria-labelledby="dlg-skills">
        <div class="dialog-body">
          <div class="dialog-head">
            <span class="dialog-kicker">{hero.dialogs.skills.kicker}</span>
            <button type="button" class="dialog-close" aria-label="Close">
              <Icon name="close" size={21} />
            </button>
          </div>
          <h2 id="dlg-skills">{hero.dialogs.skills.title}</h2>
          <p class="dialog-lede">{skills.lede}</p>
          {
            skills.clusters.map((cluster) => (
              <>
                <p class="dialog-group">{cluster.title}</p>
                <ul class="dialog-chips">
                  {cluster.items.map((item) => <li>{item}</li>)}
                </ul>
              </>
            ))
          }
        </div>
      </dialog>

      <dialog class="hero-dialog" data-panel="contact" aria-labelledby="dlg-contact">
        <div class="dialog-body">
          <div class="dialog-head">
            <span class="dialog-kicker">{hero.dialogs.contact.kicker}</span>
            <button type="button" class="dialog-close" aria-label="Close">
              <Icon name="close" size={21} />
            </button>
          </div>
          <h2 id="dlg-contact">{hero.dialogs.contact.title}</h2>
          <p class="dialog-lede">Tell me a little about what you have in mind.</p>
          <div class="hero-actions-row">{site.contact.links.filter(link => link.href !== "#" && !link.href.includes("example.com")).map(link => <a class="text-link" href={link.href}>{link.label}</a>)}</div>

          <form class="contact-form-dialog">
            <label class="dialog-field">
              Your name
              <input
                class="contact-field"
                name="name"
                autocomplete="name"
                placeholder="Alex Morgan"
                required
                maxlength="120"
              />
            </label>
            <label class="dialog-field">
              Email address
              <input
                class="contact-field"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="alex@company.com"
                required
                maxlength="254"
              />
            </label>
            <label class="dialog-field">
              A little about your project
              <textarea
                class="contact-field"
                name="message"
                rows="3"
                placeholder="The big idea, the small details, or just a hello…"
                required
                maxlength="5000"></textarea>
            </label>

            <div class="dialog-actions">
              <button type="submit" class="dialog-btn dialog-btn-solid">
                <Icon name="copy" size={16} /> Copy enquiry
              </button>
              <button type="button" class="dialog-btn dialog-btn-ghost" data-action="save-enquiry">
                <Icon name="download" size={16} /> Save enquiry
              </button>
            </div>
          </form>

          <p class="dialog-notice" role="status" aria-live="polite"></p>
          <p class="dialog-footnote">
            Nothing is sent to a server yet — copy or save your enquiry and email it across.
          </p>
        </div>
      </dialog>
    </div>

    <!-- ============ Selected work ============ -->
    <section class="selected-work" id="projects" aria-labelledby="work-title" tabindex="-1">
      <div class="work-shell">
        <div class="work-intro">
          <div>
            <h2 id="work-title" class="work-heading" aria-label="Things I've built.">
              {
                ["Things", "I've", "built."].map((word, i) => (
                  <>
                    {i > 0 && " "}
                    <span class={`work-word${i === 2 ? " work-word-accent" : ""}`} aria-hidden="true">
                      <span class="work-word-inner" data-work-reveal="word" data-delay={i * 90}>
                        {word}
                      </span>
                      {i === 2 && (
                        <svg class="work-underline" viewBox="0 0 150 10" preserveAspectRatio="none" aria-hidden="true">
                          <path d="M2 7Q65 0 148 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" pathLength="1" />
                        </svg>
                      )}
                    </span>
                  </>
                ))
              }
            </h2>
            <p class="work-description" data-work-reveal="fade" data-delay="180">{projects.lede}</p>
          </div>


        </div>

        <div class="work-grid">
          {
            projects.items.map((project, index) => (
              <div class="project-reveal" data-work-reveal="card" data-delay={(index % 2) * 110}>
                <article class="work-card" data-project={project.id} aria-labelledby={`${project.id}-title`}>
                  <div class="work-card-glow" aria-hidden="true"></div>
                  <div class="work-card-meta">
                    <span class="work-icon"><Icon name={project.icon} size={23} /></span>
                    <span class="work-kind">{project.kind}</span>
                    <span class="work-number" aria-hidden="true">{project.number}</span>
                  </div>
                  <h3 id={`${project.id}-title`}>{project.name}</h3>
                  <p class="work-card-description">{project.summary}</p>
                  <ul class="work-tags" aria-label={`${project.name} technologies`}>
                    {project.tags.map((tag, i) => <li style={`--tag-i:${i}`}>{tag}</li>)}
                  </ul>
                  <div class="project-link-row"><a class="text-link" href={`/projects/${project.id}/`}>Explore project ↗</a></div>
                </article>
              </div>
            ))
          }
        </div>


      </div>
    </section>

    <BlogListing preview />
    <Footer />
    <script>
      import { initHero } from "../scripts/hero.js";
      import { initNavProximity } from "../scripts/nav-proximity.js";
      initHero(document.querySelector(".hero-root"));
      initNavProximity(document.querySelector(".hero-nav-links"));
    </script>
    <Analytics />
</body>
</html>
