---
import { getCollection, render } from "astro:content";
import Editorial from "../../layouts/Editorial.astro";
import Comments from "../../components/Comments.astro";
export async function getStaticPaths() {
  const posts = await getCollection("blog", ({data}) => !data.draft);
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const date = post.data.date.toLocaleDateString("en-NZ", { day: "numeric", month: "long", year: "numeric", timeZone: "Pacific/Auckland" });
---
<Editorial title={post.data.title} description={post.data.description}>
  <div class="article-shell">
    <a class="text-link" href="/blog/">← All field notes</a>
    <header class="article-header"><p class="article-category">{post.data.category}</p><h1>{post.data.title}</h1><p class="article-deck">{post.data.description}</p>
      <div class="article-meta"><span>Beroxv</span><time datetime={post.data.date.toISOString()}>{date}</time><span>{post.data.readingMinutes} min read</span></div>
    </header>
    <div class="article-layout">
      <aside class="article-toc"><nav aria-label="In this article"><h2>IN THIS NOTE</h2>{headings.filter(h=>h.depth === 2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</nav></aside>
      <div class="article-body"><div class="prose"><Content /></div><Comments /><a class="text-link" href="/blog/">← Explore more field notes</a></div>
    </div>
  </div>
</Editorial>

